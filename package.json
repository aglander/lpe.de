{
  "name": "lpe-de",
  "private": true,
  "description": "Astro site for lpe.de",
  "version": "1.0.0",
  "author": "LPE & GREY",
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.3",
    "flowbite": "^4.0.1",
    "node-fetch": "^2.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tailwindcss/vite": "^4.2.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^14.5.3",
    "stylelint-config-standard": "^25.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "astro",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "0BSD",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "provenexpert:fetch-summary": "node --env-file-if-exists=.env.local scripts/provenexpert-fetch-summary.mjs",
    "provenexpert:fetch-raw": "node --env-file-if-exists=.env.local scripts/provenexpert-fetch-raw.mjs",
    "provenexpert:sync": "npm run provenexpert:fetch-summary && npm run provenexpert:fetch-raw",
    "google:fetch-reviews": "node --env-file-if-exists=.env.local scripts/google-fetch-reviews.mjs",
    "ratings:sync": "npm run provenexpert:sync && npm run google:fetch-reviews",
    "format": "prettier --write \"**/*.{astro,js,jsx,ts,tsx,json,md,mdx,css}\"",
    "audit:seo": "node scripts/validate-content-seo.mjs",
    "audit:seo:strict": "node scripts/validate-content-seo.mjs --strict-warnings",
    "audit:urls": "node scripts/url-audit.mjs",
    "test": "npm run check && npm run build && npm run audit:seo && npm run audit:urls"
  }
}
