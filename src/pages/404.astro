---
import BaseLayout from "../components/BaseLayout.astro";
import Section from "../components/Section.astro";
---

<BaseLayout title="404 | LPE.de" noindex={true}>
  <Section>
    <h1 class="mb-4 text-4xl font-bold text-grey">404: Nicht gefunden</h1>
    <p>Die angeforderte Seite existiert leider nicht oder wurde verschoben.</p>
    <p class="mt-6">
      <a href="/" class="btn-primary">Zur Startseite</a>
    </p>
  </Section>
</BaseLayout>
