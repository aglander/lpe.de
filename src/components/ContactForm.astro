<div class="mx-auto max-w-5xl text-center">
  <div class="mb-2 text-center hyphens-auto">
    <h2 class="py-2 text-2xl font-bold text-grey lg:text-4xl">Kontakt</h2>
    <p class="text-lg text-textlight">
      Wir freuen uns auf Ihre Nachricht und melden uns umgehend bei Ihnen zurück.
    </p>
  </div>
  <form name="contact-form" method="post" action="https://form.taxi/s/yqwc7dz5">
    <input type="hidden" name="form-name" value="contact-form" />
    <div class="grid md:grid-cols-2 md:gap-8">
      <div>
        <input
          type="text"
          name="fullname"
          class="mt-4 block w-full rounded-md border border-divider bg-lightgrey py-4 pl-4 text-xl focus:border-green focus:bg-white focus:outline-none md:mt-8"
          placeholder="Name"
          required
        />
        <input
          type="email"
          name="email"
          class="mt-4 block w-full rounded-md border border-divider bg-lightgrey py-4 pl-4 text-xl focus:border-green focus:bg-white focus:outline-none md:mt-8"
          placeholder="E-Mail-Adresse"
          required
        />
      </div>
      <div>
        <input
          type="tel"
          name="phone"
          class="mt-4 block w-full rounded-md border border-divider bg-lightgrey py-4 pl-4 text-xl focus:border-green focus:bg-white focus:outline-none md:mt-8"
          placeholder="Telefonnummer"
          required
        />
        <input
          type="text"
          name="address"
          class="mt-4 block w-full rounded-md border border-divider bg-lightgrey py-4 pl-4 text-xl focus:border-green focus:bg-white focus:outline-none md:mt-8"
          placeholder="Straße & Hausnr., PLZ & Ort"
          required
        />
      </div>
    </div>
    <div>
      <textarea
        name="message"
        class="mt-4 block h-28 w-full rounded-md border border-divider bg-lightgrey py-4 pl-4 text-xl focus:border-green focus:bg-white focus:outline-none md:mt-8"
        placeholder="Nachricht"
        required
      ></textarea>
      <button type="submit" class="mt-8 btn-primary">Absenden</button>
    </div>
  </form>
</div>
