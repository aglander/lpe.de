---
import { getChildren } from "../../lib/navigation.js";

type NavigationItem = {
  navId: string;
  title: string;
  url: string;
};

const { id } = Astro.props as { id: string };
const sections = getChildren(id) as NavigationItem[];
---

<ul class="mx-auto grid w-full max-w-6xl list-none gap-x-6 gap-y-10 pl-0 md:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.15fr)]">
  {sections.map((section) => (
    <li class="min-w-0 list-none">
      <div class="mt-2 border-b border-divider pb-3 text-sm uppercase leading-snug text-green md:text-base xl:text-[1.15rem]">
        {section.title}
      </div>
      <ul class="mt-6 list-none space-y-3 pl-0">
        {(getChildren(section.navId) as NavigationItem[]).map((item) => (
          <li class="min-w-0 list-none">
            <a
              href={`${item.url}/`.replace(/\/\//g, "/")}
              class="block hyphens-auto text-base leading-8 text-text hover:text-green"
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>
