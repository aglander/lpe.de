---
import { featuredReviews, ratingPlatforms, ratingSummary } from "../../lib/ratings.js";

const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});

const ratingValue = Number(ratingSummary.ratingValue.toFixed(2));
const reviewCount = Number(ratingSummary.reviewCount);
const portalCount = ratingPlatforms.length;
const updatedAtLabel = ratingSummary.updatedAt
  ? dateFormatter.format(new Date(ratingSummary.updatedAt))
  : null;
const hasReviewAvatars = featuredReviews.some((review) => typeof review.avatarUrl === "string" && review.avatarUrl.length > 0);

const reviewsWithPreview = featuredReviews.map((review) => {
  const fullText = typeof review.text === "string" ? review.text.replace(/\s+/g, " ").trim() : "";

  return {
    ...review,
    fullText,
    previewText: fullText,
    isExpandable: fullText.length > 0,
  };
});
---

<div class="rating-module my-10 space-y-6 lg:my-14">
  <div class="text-center [hyphens:auto]">
    <div class="flex items-center justify-center gap-3 text-yellow">
      <i class="fas fa-star text-4xl text-yellow"></i>
      <i class="fas fa-star text-4xl text-yellow"></i>
      <i class="fas fa-star text-4xl text-yellow"></i>
      <i class="fas fa-star text-4xl text-yellow"></i>
      <i class="fas fa-star text-4xl text-yellow"></i>
    </div>
    <h2 class="py-2 text-2xl font-bold text-grey lg:text-4xl">
      <span class="text-green">
        {ratingValue.toFixed(2).replace(".", ",")} von 5 -
      </span>{" "}
      bewertet von unseren Kunden
    </h2>
    <p class="mt-2 text-lg text-textlight">
      Basierend auf {reviewCount} Kundenbewertungen auf {portalCount} unabhängigen
      Bewertungsportalen{updatedAtLabel ? ` (Stand: ${updatedAtLabel})` : ""}
    </p>
  </div>

  <div>
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h3 class="text-2xl font-bold text-grey">Aktuelle Kundenstimmen</h3>
      </div>
      <div class="hidden items-center gap-2 md:flex">
        <button
          type="button"
          class="rating-carousel-button inline-flex h-11 w-11 items-center justify-center rounded-full border border-divider bg-white text-grey shadow-sm transition hover:border-green hover:text-green"
          data-direction="-1"
          aria-label="Bewertungen nach links scrollen"
        >
          <span class="fas fa-chevron-left"></span>
        </button>
        <button
          type="button"
          class="rating-carousel-button inline-flex h-11 w-11 items-center justify-center rounded-full border border-divider bg-white text-grey shadow-sm transition hover:border-green hover:text-green"
          data-direction="1"
          aria-label="Bewertungen nach rechts scrollen"
        >
          <span class="fas fa-chevron-right"></span>
        </button>
      </div>
    </div>

    <div
      data-rating-module
      class="-mx-4 overflow-hidden px-4"
    >
      <div
        data-rating-track
        class="flex items-start snap-x snap-mandatory gap-4 overflow-x-auto pb-4 pr-4 [scrollbar-width:thin]"
      >
        {reviewsWithPreview.map((review) => (
          <article
            class:list={[
              "rating-review-card",
              "content-box !my-0 flex h-[300px] w-[84%] shrink-0 self-start snap-start flex-col !rounded-2xl !border !bg-white !p-5 text-left shadow-sm sm:w-[72%] md:w-[380px]",
              review.isExpandable && "rating-review-card--expandable cursor-pointer",
            ]}
            data-expandable={review.isExpandable ? "true" : "false"}
            tabindex={review.isExpandable ? "0" : undefined}
            role={review.isExpandable ? "button" : undefined}
            aria-expanded={review.isExpandable ? "false" : undefined}
          >
            <div class="mb-3 flex items-start justify-between gap-3">
              <div class="flex min-w-0 items-start gap-3">
                {hasReviewAvatars && (
                  review.avatarUrl ? (
                    <img
                      src={review.avatarUrl}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="mt-0.5 h-11 w-11 shrink-0 rounded-full border border-divider object-cover"
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-divider bg-lightgrey text-sm text-textlight"
                    >
                      <span class="fas fa-user"></span>
                    </span>
                  )
                )}
                <div class="min-w-0">
                  <p class="truncate font-bold text-grey">{review.authorName}</p>
                  <p class="truncate whitespace-nowrap text-sm text-textlight">
                    <span>{dateFormatter.format(new Date(review.publishedAt))} · </span>
                    <span>{review.providerLabel}</span>
                  </p>
                </div>
              </div>
              <span class="shrink-0 text-sm tracking-wide text-yellow" aria-label="5 von 5 Sternen">
                ★★★★★
              </span>
            </div>

            <p class="rating-review-text rating-review-preview h-[6rem] shrink-0 text-sm leading-6 text-textlight [hyphens:auto]">
              {review.previewText}
            </p>
            <p class="rating-review-text rating-review-full text-sm leading-6 text-textlight [hyphens:auto]">
              {review.fullText}
            </p>

            <div class="mt-auto pt-3">
              <a
                href={review.reviewUrl}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-base leading-6 font-semibold text-green no-underline hover:text-darkgreen"
              >
                Bewertung ansehen
                <span class="fas fa-arrow-up-right-from-square text-sm"></span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-start justify-center gap-x-6 gap-y-4 pt-2">
    {ratingPlatforms.map((platform) => {
      return (
        <a
          href={platform.href}
          target="_blank"
          rel="noreferrer"
          aria-label={platform.name}
          title={platform.name}
          class="group flex min-w-28 shrink-0 flex-col items-center justify-start gap-2 px-1 py-1 text-center transition hover:-translate-y-0.5"
        >
          {platform.logoSrc ? (
            <img
              src={platform.logoSrc}
              alt={platform.name}
              loading="lazy"
              decoding="async"
              class="block h-auto max-h-10 w-auto max-w-[170px] object-contain opacity-70 saturate-[0.7] transition duration-200 group-hover:opacity-100 group-hover:saturate-100"
            />
          ) : (
            <span class="fab fa-facebook-f text-2xl text-grey opacity-70 transition duration-200 group-hover:text-[#1877F2] group-hover:opacity-100"></span>
          )}
          <span class="text-xs leading-tight text-textlight">{platform.name}</span>
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  document.querySelectorAll("[data-rating-module]").forEach((module) => {
    const track = module.querySelector("[data-rating-track]");
    if (!track) return;

    const expandableCards = module.querySelectorAll("[data-expandable='true']");
    const buttons = module.parentElement?.querySelectorAll(".rating-carousel-button");
    buttons?.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = Number(button.getAttribute("data-direction") || "0");
        const amount = track.clientWidth * 0.85 * direction;
        track.scrollBy({ left: amount, behavior: "smooth" });
      });
    });

    const syncExpandedState = () => {
      const isExpanded = module.classList.contains("rating-module-expanded");
      expandableCards.forEach((card) => {
        card.setAttribute("aria-expanded", String(isExpanded));
      });
    };

    const toggleExpanded = () => {
      module.classList.toggle("rating-module-expanded");
      syncExpandedState();
    };

    expandableCards.forEach((card) => {
      card.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          return;
        }

        toggleExpanded();
      });

      card.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") {
          return;
        }

        event.preventDefault();
        toggleExpanded();
      });
    });

    syncExpandedState();
  });
</script>
