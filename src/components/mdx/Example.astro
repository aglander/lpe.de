---
import { Image } from "astro:assets";
import { localImageMap } from "../../lib/local-images.js";

const { title, children, number, link, image } = Astro.props;
const localImage = typeof image === "string" ? localImageMap[image] : undefined;
---

{link ? (
  <a href={link} target="_blank" rel="noopener noreferrer">
    <div class="inline-block align-top text-left sm:w-1/2 lg:w-1/3">
      {image ? (
        <div class="m-1 rounded-2xl border-2 border-green bg-white p-5">
          {localImage ? (
            <Image
              src={localImage}
              alt={title}
              height={50}
              sizes="200px"
              loading="lazy"
              decoding="async"
              class="mb-2 inline-block h-[50px] w-auto"
            />
          ) : (
            <img src={image} alt={title} class="mb-2 inline-block h-[50px]" loading="lazy" decoding="async" />
          )}
          <h4 class="mb-2 text-xl font-bold [hyphens:auto]">{title}</h4>
          <p class="text-base [hyphens:auto]"><slot /></p>
        </div>
      ) : (
        <div class="m-4">
          <span class="mb-2 inline-block rounded-2xl border-2 border-green bg-white px-4 py-2 text-2xl text-green">
            {number}
          </span>
          <h4 class="mb-2 text-xl font-bold [hyphens:auto]">{title}</h4>
          <p class="text-base [hyphens:auto]"><slot /></p>
        </div>
      )}
    </div>
  </a>
) : (
  <div class="inline-block align-top text-left sm:w-1/2 lg:w-1/3">
    {image ? (
      <div class="m-1 rounded-2xl border-2 border-green bg-white p-5">
        {localImage ? (
          <Image
            src={localImage}
            alt={title}
            height={50}
            sizes="200px"
            loading="lazy"
            decoding="async"
            class="mb-2 inline-block h-[50px] w-auto"
          />
        ) : (
          <img src={image} alt={title} class="mb-2 inline-block h-[50px]" loading="lazy" decoding="async" />
        )}
        <h4 class="mb-2 text-xl font-bold [hyphens:auto]">{title}</h4>
        <p class="text-base [hyphens:auto]"><slot /></p>
      </div>
    ) : (
      <div class="m-4">
        <span class="mb-2 inline-block rounded-2xl border-2 border-green bg-white px-4 py-2 text-2xl text-green">
          {number}
        </span>
        <h4 class="mb-2 text-xl font-bold [hyphens:auto]">{title}</h4>
        <p class="text-base [hyphens:auto]"><slot /></p>
      </div>
    )}
  </div>
)}
