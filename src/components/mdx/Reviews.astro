---
import { Image } from "astro:assets";
import ProvenExpert from "./ProvenExpert.astro";
import { reviewImages, reviewLogos } from "../../lib/local-images.js";

const reviews = [
  {
    authorName: "Steffi Richter",
    authorPhoto: reviewImages.review1,
    topic: "Altersvorsorge & Versicherungen",
    text:
      "Seit Jahren mein persönlicher Ansprechpartner Nr. 1 für Versicherungen und Altersvorsorge. Gerade bei meiner Existenzgründung hat Lars-Peter Eckhardt mir ein tolles Paket geschnürt.",
  },
  {
    authorName: "Arian Glander",
    authorPhoto: reviewImages.review2,
    topic: "Versicherungen & Finanzierung",
    text:
      "Seit zwei Jahrzehnten vertraue ich Lars-Peter Eckhardt wenn es um Versicherungen oder Finanzierungen geht. Er findet immer die richtige Lösung.",
  },
  {
    authorName: "Josefina Bils",
    authorPhoto: reviewImages.review3,
    topic: "Finanzierung & Absicherung",
    text:
      "LPE hat uns zu unserer Traumimmobilie verholfen. Es war eine ehrliche und vertrauensvolle Zusammenarbeit, für die wir als Familie sehr dankbar sind.",
  },
];

const logos = [
  {
    href: "https://www.provenexpert.com/de-de/lars-peter-eckhardt",
    alt: "ProvenExpert",
    image: reviewLogos.provenExpertLogo,
    width: 131,
    height: 36,
  },
  {
    href: "https://www.whofinance.de/berater/lars-peter-eckhardt",
    alt: "WhoFinance",
    image: reviewLogos.whoFinanceLogo,
    width: 118,
    height: 36,
  },
  {
    href: "https://g.page/LPE99?share",
    alt: "Google",
    image: reviewLogos.googleLogo,
    width: 106,
    height: 36,
  },
  {
    href: "https://www.kennstdueinen.de/finanzdienstleistungen-woltersdorf-lars-peter-eckhardt-versicherungsmakler-finanzmakler-d150186.html",
    alt: "KennstDuEinen",
    image: reviewLogos.kennstDuEinenLogo,
    width: 131,
    height: 36,
  },
];
---

<div class="mb-2 text-center [hyphens:auto]">
  <div>
    <i class="fas fa-star text-4xl text-yellow"></i>
    <i class="fas fa-star text-4xl text-yellow"></i>
    <i class="fas fa-star text-4xl text-yellow"></i>
    <i class="fas fa-star text-4xl text-yellow"></i>
    <i class="fas fa-star text-4xl text-yellow"></i>
  </div>
  <h2 class="py-2 text-2xl font-bold text-grey lg:text-4xl">
    <span class="text-green">Wir beraten Sie sehr gut, sagen unsere Kunden!</span>
  </h2>
  <p class="text-lg text-textlight">
    Die vielen positiven Bewertungen und Rückmeldungen sind uns eine große Ehre und dauerhafter Anspruch zugleich.
  </p>
</div>

<ProvenExpert />

<div class="grid gap-5 lg:grid-cols-3">
  {reviews.map((review) => (
    <div class="content-box bg-lightgrey">
      <div class="flex h-full flex-col">
        <i class="fas fa-quote-right mx-auto mb-4 rounded-lg bg-green p-3 text-lg text-white lg:text-2xl"></i>
        <p class="flex-1 text-base leading-7 [hyphens:auto]">{review.text}</p>
        <div class="mt-3 flex flex-col items-center">
          <Image
            src={review.authorPhoto}
            alt={review.authorName}
            width={44}
            height={44}
            sizes="44px"
            loading="lazy"
            decoding="async"
            class="mb-1.5 rounded-full object-cover"
          />
          <h3 class="mb-1 text-center text-xl font-bold leading-tight text-grey lg:text-2xl">
            {review.authorName}
          </h3>
          <p class="text-center text-sm leading-snug text-textlight lg:text-base">{review.topic}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<div class="text-center">
  {logos.map((logo) => (
    <a href={logo.href} target="_blank" rel="noreferrer">
      <Image
        src={logo.image}
        alt={logo.alt}
        width={logo.width}
        height={logo.height}
        sizes={`${logo.width}px`}
        loading="lazy"
        decoding="async"
        class="mx-5 inline-block grayscale hover:grayscale-0"
      />
    </a>
  ))}
</div>
