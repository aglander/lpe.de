---
const { trackingId } = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed right-4 bottom-4 z-50 hidden max-w-md rounded-2xl border border-divider bg-white p-5 shadow-2xl"
>
  <p class="text-sm text-text">
    Wir verwenden Cookies und externe Dienste nur mit Ihrer Einwilligung.
  </p>
  <div class="mt-4 flex gap-3">
    <button id="cookie-accept" type="button" class="btn-primary">Akzeptieren</button>
    <button id="cookie-decline" type="button" class="btn-outline">Ablehnen</button>
  </div>
</div>

<script is:inline define:vars={{ trackingId }}>
  const storageKey = "lpe-cookie-consent";

  const loadAnalytics = () => {
    if (!trackingId || document.querySelector('script[data-lpe-ga="true"]')) return;
    const external = document.createElement("script");
    external.async = true;
    external.src = `https://www.googletagmanager.com/gtag/js?id=${trackingId}`;
    external.dataset.lpeGa = "true";
    document.head.appendChild(external);

    const inline = document.createElement("script");
    inline.dataset.lpeGa = "true";
    inline.textContent = `
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${trackingId}');
    `;
    document.head.appendChild(inline);
  };

  const banner = document.getElementById("cookie-consent");
  const consent = window.localStorage.getItem(storageKey);

  if (!consent && banner) {
    banner.classList.remove("hidden");
  }

  if (consent === "accepted") {
    loadAnalytics();
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    window.localStorage.setItem(storageKey, "accepted");
    banner?.classList.add("hidden");
    loadAnalytics();
  });

  document.getElementById("cookie-decline")?.addEventListener("click", () => {
    window.localStorage.setItem(storageKey, "declined");
    banner?.classList.add("hidden");
  });
</script>
